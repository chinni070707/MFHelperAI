# MFHelper Backend Environment Variables
# Copy this file to .env and update with your actual values

# Application
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production

# Database
DATABASE_URL=sqlite:///./mfhelper.db

# ====== Google OAuth (Optional) ======
# Get credentials from: https://console.cloud.google.com/
# See docs/GOOGLE_OAUTH_SETUP.md for setup instructions
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ====== AI Configuration ======
# Choose: 'ollama' (free, local) or 'openai' (paid, cloud)
AI_TYPE=ollama
AI_ENABLED=true

# ====== Ollama Configuration (Local AI - TinyLlama) ======
# Keep these defaults for local, free AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama

# Optional: Upgrade to better model (download with: ollama pull phi3:mini)
# OLLAMA_MODEL=phi3:mini    # Better quality (2.7GB)
# OLLAMA_MODEL=mistral      # Best quality (4GB)
# OLLAMA_MODEL=llama2:7b    # Very capable (3.8GB)

# ====== OpenAI Configuration (Optional - Only if NOT using Ollama) ======
# Leave blank to use local Ollama instead
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# CAS Testing (for test scripts)
# This is YOUR CAS PDF password (usually your PAN number)
CAS_TEST_PASSWORD=YOUR_CAS_PASSWORD_HERE

# CAS Test File Path (optional)
CAS_TEST_FILE=C:\Users\YOUR_USERNAME\Downloads\CAS_FILE.pdf

# CAMS API (Optional - for future integration)
CAMS_API_URL=https://api.camsonline.com/v1
CAMS_API_KEY=
CAMS_API_SECRET=

# KFintech API (Optional)
KFINTECH_API_URL=https://api.kfintech.com/v1
KFINTECH_API_KEY=
KFINTECH_API_SECRET=

# Email (Optional - for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Sentry (Optional - for error tracking)
SENTRY_DSN=

# Redis (Optional - for caching)
REDIS_URL=

# Example environment variables for MFHelper

# App settings
APP_NAME=MFHelper
DEBUG=true
SECRET_KEY=change-me-in-prod

# Database (Postgres recommended in production)
# Example: postgresql://mfhelper:strongpassword@db:5432/mfhelper
DATABASE_URL=postgresql://mfhelper:strongpassword@db:5432/mfhelper

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI settings
AI_TYPE=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama
OPENAI_API_KEY=

# Sentry (optional)
SENTRY_DSN=

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
